# MOBIX Mobile Shop Management System Configuration
SECRET_KEY=mobix_super_secret_key_2026_modern_pos
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration
# Default is SQLite for zero-config quick start.
DATABASE_URL=sqlite:///mobix.db
# For MySQL usage, uncomment and adjust:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/mobix_db

# Email Notification Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-shop-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=MOBIX Mobile Solutions <noreply@mobix.com>

# WhatsApp Business / Web Hook Configuration
WHATSAPP_ENABLED=True
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
